APP_NAME=mdb-mcp-gateway
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

AUTH_MODE=disabled
REQUIRE_AUTH=false

MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_URI_FILE=
MONGODB_DB_NAME=mcp_gateway

# Embedding provider. The active config can also be changed at runtime from the
# admin panel (persisted in the control DB, taking precedence over these envs).
# Supported: ollama | openai | azure_openai | voyage | gemini
EMBEDDING_PROVIDER=ollama
# Optional: override the model (defaults per provider). For Ollama this falls back
# to OLLAMA_MODEL below.
EMBEDDING_MODEL=
# Optional: override the provider base URL (e.g. an OpenAI-compatible gateway).
EMBEDDING_BASE_URL=
# API key for cloud providers (openai/azure_openai/voyage/gemini). Prefer a file
# mount in production via EMBEDDING_API_KEY_FILE.
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_FILE=
# Azure OpenAI specifics (provider=azure_openai). EMBEDDING_MODEL is the deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT=
# Probe string embedded once to auto-detect the provider's native vector width.
EMBEDDING_PROBE_TEXT=embedding dimension probe
# Secret used to encrypt provider API keys at rest in the control DB. Falls back
# to ADMIN_SESSION_SECRET / JWT_SECRET when unset.
EMBEDDING_SECRET=
EMBEDDING_SECRET_FILE=

# Ollama (default local provider).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text
# Fallback/declared width for the Ollama default; other providers auto-detect.
OLLAMA_DIMENSIONS=768

JWT_SECRET=change-me
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=mdb-mcp-gateway
JWKS_URI=
JWKS_URI_FILE=
JWKS_LOCAL_PATH=./config/dev-jwks.json
JWKS_CACHE_TTL_SECONDS=300
# On an unknown key id, refresh JWKS out-of-band instead of waiting for the TTL,
# but at most once per this interval (guards the IdP against bogus-kid floods).
JWKS_MIN_REFRESH_SECONDS=60
DEFAULT_TENANT_ID=local-dev
TENANT_DB_PREFIX=tenant_
PLATFORM_ADMIN_ROLE=platform-admin
# Create a tenant's database + indexes on first use. Set to false where tenant
# ids come from untrusted callers and provisioning must be an explicit step.
AUTO_PROVISION_TENANTS=true

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# sliding_window removes the fixed-window burst-at-the-boundary problem; set to
# fixed_window to restore the legacy per-window counter behavior.
RATE_LIMIT_STRATEGY=sliding_window

HYBRID_VECTOR_WEIGHT=0.5
HYBRID_TEXT_WEIGHT=0.5
HYBRID_NUM_CANDIDATES=100
HYBRID_PIPELINE_LIMIT=20
HYBRID_OUTPUT_LIMIT=10
INCLUDE_SCORE_DETAILS=true
FUSION_STRATEGY=rank_fusion

# Semantic tools/list discovery
ROUTE_TOP_K=5
CATALOG_LIST_LIMIT=200
QUERY_HEADER=x-mcp-query
SCOPES_HEADER=x-mcp-scopes

SEMANTIC_CACHE_THRESHOLD=0.95
HTTP_TIMEOUT_SECONDS=20
EMBEDDING_TIMEOUT_SECONDS=8
EMBEDDING_RETRY_ATTEMPTS=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
EMBEDDING_CIRCUIT_FAILURES=5
EMBEDDING_CIRCUIT_RESET_SECONDS=30
EMBEDDING_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_MAX_ENTRIES=512
DOWNSTREAM_TIMEOUT_MS=2000

ENABLE_METRICS=true
ENABLE_TRACING=false
LOG_JSON=true
REQUEST_MAX_BYTES=262144
GUARDRAIL_ML_ENABLED=false
GUARDRAIL_INJECTION_THRESHOLD=0.85
GUARDRAIL_FAIL_MODE=open
GUARDRAIL_TIMEOUT_SECONDS=1.5
GUARDRAIL_CIRCUIT_FAILURES=5
GUARDRAIL_CIRCUIT_RESET_SECONDS=30
GUARDRAIL_SIGNATURE_TOP_K=3
GUARDRAIL_PII_NER_ENABLED=false
CORS_ALLOW_ORIGINS=*

ATLAS_TLS=false
ATLAS_TLS_CA_FILE=
ATLAS_AUTH_SOURCE=
ATLAS_AUTH_MECHANISM=
ATLAS_USERNAME=
ATLAS_PASSWORD=
ATLAS_PASSWORD_FILE=
