APP_NAME=mdb-mcp-gateway
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Read natively by uvicorn (the image runs with --proxy-headers). Behind a
# TLS-terminating proxy, set this to the proxy's IP/CIDR so X-Forwarded-For (per-IP
# rate limiting) and X-Forwarded-Proto (Secure cookies) are honored. Defaults to
# 127.0.0.1; never use "*" if the gateway can be reached directly by clients.
FORWARDED_ALLOW_IPS=127.0.0.1

AUTH_MODE=disabled
# Inbound MCP-client auth for the gateway's own surface (/rpc, /mcp).
# POST /auth/token always works (username/password -> bearer). Set MCP_BASIC_AUTH_ENABLED
# to also accept HTTP Basic directly. OAUTH_METADATA_ENABLED advertises RFC 9728
# Protected Resource Metadata for discovery (auto-on under AUTH_MODE=jwks).
MCP_BASIC_AUTH_ENABLED=false
OAUTH_METADATA_ENABLED=false

MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_URI_FILE=
MONGODB_DB_NAME=mcp_gateway
# Queryable Encryption (QE) for routing_registry secrets (`env`, `command`,
# `args`, `metadata`). Off by default outside Docker Compose.
QE_ENABLED=false
# none | local | aws
KMS_PROVIDER=none
# Namespace containing DEKs (wrapped by your KMS key).
QE_KEY_VAULT_NAMESPACE=encryption.__keyVault
# Path to mongo_crypt_v1 shared library inside the runtime image.
CRYPT_SHARED_LIB_PATH=/opt/mongodb/lib/mongo_crypt_v1.so
# Local KMS mode: base64-encoded 96-byte master key.
QE_LOCAL_MASTER_KEY=
QE_LOCAL_MASTER_KEY_FILE=
# AWS KMS mode (LocalStack in local dev).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY_FILE=
AWS_DEFAULT_REGION=us-east-1
# LocalStack endpoint should use localhost.localstack.cloud to satisfy TLS CN.
AWS_KMS_ENDPOINT=
AWS_KMS_KEY_ARN=
AWS_KMS_KEY_ARN_FILE=

# Embedding provider. The active config can also be changed at runtime from the
# admin panel (persisted in the control DB, taking precedence over these envs).
# Supported: ollama | openai | azure_openai | voyage | gemini
EMBEDDING_PROVIDER=ollama
# Optional: override the model (defaults per provider). For Ollama this falls back
# to OLLAMA_MODEL below.
EMBEDDING_MODEL=
# Optional: override the provider base URL (e.g. an OpenAI-compatible gateway).
EMBEDDING_BASE_URL=
# API key for cloud providers (openai/azure_openai/voyage/gemini). Prefer a file
# mount in production via EMBEDDING_API_KEY_FILE.
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_FILE=
# Voyage AI drop-in (MongoDB's first-party embeddings). Setting VOYAGE_API_KEY
# ALONE is enough: it promotes the default provider (ollama) to voyage and
# authenticates it (model voyage-3, vector width auto-detected). An explicit
# EMBEDDING_PROVIDER / EMBEDDING_API_KEY above always wins, and the admin panel
# can override provider/model/key at runtime. Prefer VOYAGE_API_KEY_FILE in prod.
VOYAGE_API_KEY=
VOYAGE_API_KEY_FILE=
# Azure OpenAI specifics (provider=azure_openai). EMBEDDING_MODEL is the deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT=
# Probe string embedded once to auto-detect the provider's native vector width.
EMBEDDING_PROBE_TEXT=embedding dimension probe
# Secret used to encrypt provider API keys at rest in the control DB. Falls back
# to ADMIN_SESSION_SECRET / JWT_SECRET when unset.
EMBEDDING_SECRET=
EMBEDDING_SECRET_FILE=

# Ollama (default local provider).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text
# Fallback/declared width for the Ollama default; other providers auto-detect.
OLLAMA_DIMENSIONS=768

JWT_SECRET=change-me
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=mdb-mcp-gateway
JWKS_URI=
JWKS_URI_FILE=
JWKS_LOCAL_PATH=./config/dev-jwks.json
JWKS_CACHE_TTL_SECONDS=300
# On an unknown key id, refresh JWKS out-of-band instead of waiting for the TTL,
# but at most once per this interval (guards the IdP against bogus-kid floods).
JWKS_MIN_REFRESH_SECONDS=60
DEFAULT_TENANT_ID=local-dev
TENANT_DB_PREFIX=tenant_
# Optional unique instance id for change-stream resume tokens. If unset, the
# gateway falls back to the host name.
GATEWAY_INSTANCE_ID=
# TTL (seconds) for per-instance watcher resume-token docs.
WATCHER_RESUME_TTL_SECONDS=86400
PLATFORM_ADMIN_ROLE=platform-admin
# Execute user-authored code tools (transport="code") in the wasm sandbox.
# Keep false to allow authoring/search without runtime execution.
CODE_TOOL_EXECUTION_ENABLED=false
# TTL (seconds) for approval-gated pending actions in HITL flow.
CONFIRMATION_TTL_SECONDS=3600
# Quota period and default per-tenant quota ceilings (0 => unlimited).
USAGE_QUOTA_PERIOD=monthly
DEFAULT_QUOTA_CALLS_PER_PERIOD=0
DEFAULT_QUOTA_SANDBOX_SECONDS_PER_PERIOD=0
# Reject a code-tool call up front when its worst-case sandbox cost cannot fit the
# tenant's remaining sandbox-seconds budget (only when a sandbox-seconds quota is set).
QUOTA_PREFLIGHT_ENABLED=true
# Per-replica cache TTL for a tenant's suspended/active status (also the max delay
# before a suspend issued on one replica is honored cluster-wide). 0 = no cache.
TENANT_STATUS_CACHE_TTL_SECONDS=5
# Soft-delete retention: a deleted tenant is locked out immediately but its DB is
# kept this many days so the delete can be reversed, then the reaper drops it.
TENANT_RETENTION_DAYS=30
# Cadence (seconds) of the reaper that hard-drops soft-deleted tenants past their
# retention window. 0 = disabled (purge becomes an explicit hard-delete only).
TENANT_PURGE_SWEEP_INTERVAL_SECONDS=0
# Code-tool runtime selector: wasm (sandbox worker) or disabled.
CODE_EXECUTOR=wasm
# Path to the pinned CPython-on-WASI runtime fetched by `make fetch-wasm`.
SANDBOX_PYTHON_WASM_PATH=vendor/python-3.12.0.wasm
# Per-call sandbox limits.
SANDBOX_FUEL=4000000000
SANDBOX_MEMORY_BYTES=268435456
# 0 inherits DOWNSTREAM_TIMEOUT_MS.
SANDBOX_WALL_TIMEOUT_MS=0
SANDBOX_MAX_OUTPUT_BYTES=262144
SANDBOX_MAX_CONCURRENCY_PER_TENANT=4
# Process-wide ceiling on simultaneous sandbox executions across ALL tenants
# (0 = no global cap; only the per-tenant limit applies). Bounds total host load.
SANDBOX_MAX_GLOBAL_CONCURRENCY=0
# Code-tool pip requirements run on the HOST before the wasm jail, so they are
# deny-by-default. Comma/space separated distribution names allowed to install
# (wheels only). Empty = stdlib-only code tools.
SANDBOX_ALLOWED_REQUIREMENTS=
# Warm worker pool. 0 = spawn a throwaway worker per call (cold start each time).
# >0 keeps that many prewarmed CPython-on-WASI workers resident to hide cold starts.
SANDBOX_POOL_SIZE=0
# Recycle a pooled worker after N jobs (0 = never); RSS/leak backstop.
SANDBOX_WORKER_MAX_JOBS=0
# Retire an idle pooled worker once resident this long (seconds); 0 = never by age.
SANDBOX_WORKER_MAX_AGE_SECONDS=0
# Cadence (seconds) of the pool sweep that retires over-age / unhealthy idle
# workers. 0 = disabled (no background sweep).
SANDBOX_POOL_SWEEP_INTERVAL_SECONDS=0
# Max wait (ms) for a free pooled worker (0 = derive from SANDBOX_WALL_TIMEOUT_MS).
SANDBOX_POOL_ACQUIRE_TIMEOUT_MS=0
# Max wait (ms) for a new worker to compile its module and report ready.
SANDBOX_POOL_WARMUP_TIMEOUT_MS=20000
# Extra wait (ms), on top of a tool's wall budget, for the worker to spawn and
# boot the wasm runtime (cold start). Keeps a slow boot under host load from
# being misread as a tool timeout; raw compute stays bounded by fuel + memory.
SANDBOX_WORKER_STARTUP_GRACE_MS=10000
# Compiled-module cache dir for fast worker (re)spawn. Empty disables it.
SANDBOX_MODULE_CACHE_PATH=vendor/.wasm-cache
# Enable tenant-scoped virtual DB access in sandboxed code tools (`context.db`).
# DB operations are relayed through the host and gated by tool action_type.
# Local/dev default is enabled so seeded demos work out-of-the-box.
# Production should review this explicitly and set it according to policy.
SANDBOX_DB_BRIDGE_ENABLED=true
# Bridge limits: max docs returned per call, per-operation timeout (ms),
# max DB bridge calls per tool invocation, and max serialized bridge response size.
SANDBOX_DB_MAX_DOCS=100
SANDBOX_DB_QUERY_TIMEOUT_MS=1000
SANDBOX_DB_MAX_CALLS_PER_INVOCATION=25
SANDBOX_DB_MAX_RESULT_BYTES=131072
# Cross-tool calling: lets a code tool invoke sibling code tools in the same
# tenant via context.tools / context.call. Relayed through the host,
# re-authorized against the caller, code-tools-only, and bounded by depth +
# per-invocation call budget. Local/dev default on so the seeded
# analytics/track_and_report demo works out-of-the-box.
SANDBOX_TOOL_BRIDGE_ENABLED=true
SANDBOX_TOOL_CALL_MAX_DEPTH=3
SANDBOX_TOOL_MAX_CALLS_PER_INVOCATION=10
SANDBOX_TOOL_MAX_RESULT_BYTES=262144
# Create a tenant's database + indexes on first use. Set to false where tenant
# ids come from untrusted callers and provisioning must be an explicit step.
AUTO_PROVISION_TENANTS=true

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

HYBRID_VECTOR_WEIGHT=0.5
HYBRID_TEXT_WEIGHT=0.5
HYBRID_NUM_CANDIDATES=100
HYBRID_PIPELINE_LIMIT=20
HYBRID_OUTPUT_LIMIT=10
INCLUDE_SCORE_DETAILS=true
FUSION_STRATEGY=rank_fusion

# Semantic tools/list discovery
ROUTE_TOP_K=5
CATALOG_LIST_LIMIT=200
QUERY_HEADER=x-mcp-query
SCOPES_HEADER=x-mcp-scopes

SEMANTIC_CACHE_THRESHOLD=0.95
HTTP_TIMEOUT_SECONDS=20
EMBEDDING_TIMEOUT_SECONDS=8
EMBEDDING_RETRY_ATTEMPTS=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.25
EMBEDDING_CIRCUIT_FAILURES=5
EMBEDDING_CIRCUIT_RESET_SECONDS=30
EMBEDDING_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_MAX_ENTRIES=512
# Streamed cache/catalog re-embedding migration: docs pulled per page, and the
# max concurrent re-embed writes (bounds memory + provider load on large caches).
CACHE_MIGRATION_FETCH_PAGE_SIZE=500
CACHE_MIGRATION_EMBED_CONCURRENCY=8
DOWNSTREAM_TIMEOUT_MS=2000
# Dynamic downstream JWT brokering (local RS256 signer).
DOWNSTREAM_JWT_ENABLED=true
DOWNSTREAM_JWT_ALGORITHM=RS256
# Defaults to this repo's local demo keypair; the prod-safety validator REJECTS this
# bundled key when ENVIRONMENT=production, so set a real key file (or DOWNSTREAM_JWT_PRIVATE_KEY).
DOWNSTREAM_JWT_PRIVATE_KEY_FILE=config/dev-private-key.pem
DOWNSTREAM_JWT_PRIVATE_KEY=
DOWNSTREAM_JWT_KID=dev-local-key-1
DOWNSTREAM_JWT_ISSUER=mdb-mcp-gateway
DOWNSTREAM_TOKEN_TTL_SECONDS=120
DOWNSTREAM_TOKEN_REFRESH_SKEW_SECONDS=15
DOWNSTREAM_AUTH_HEADER=Authorization
DOWNSTREAM_TOKEN_ENV_VAR=MCP_DOWNSTREAM_TOKEN

ENABLE_METRICS=true
ENABLE_TRACING=false
LOG_JSON=true
REQUEST_MAX_BYTES=262144
# Downstream egress allowlisting for streamable_http/sse registry endpoints.
# Global entries are comma/space separated host globs / exact hosts / CIDRs
# (e.g. "*.corp.example,api.vendor.com,203.0.113.0/24"). Empty + DEFAULT_DENY=false
# preserves current behavior (publicly routable endpoints allowed).
EGRESS_ALLOWLIST_ENABLED=true
EGRESS_GLOBAL_ALLOWLIST=
EGRESS_DEFAULT_DENY=false
# Per-replica cache TTL for tenant egress allowlists from the control DB.
EGRESS_ALLOWLIST_CACHE_TTL_SECONDS=5
GUARDRAIL_ML_ENABLED=false
GUARDRAIL_INJECTION_THRESHOLD=0.85
GUARDRAIL_FAIL_MODE=open
GUARDRAIL_TIMEOUT_SECONDS=1.5
GUARDRAIL_CIRCUIT_FAILURES=5
GUARDRAIL_CIRCUIT_RESET_SECONDS=30
GUARDRAIL_SIGNATURE_TOP_K=3
GUARDRAIL_PII_NER_ENABLED=false
CORS_ALLOW_ORIGINS=*

ATLAS_TLS=false
ATLAS_TLS_CA_FILE=
ATLAS_AUTH_SOURCE=
ATLAS_AUTH_MECHANISM=
ATLAS_USERNAME=
ATLAS_PASSWORD=
ATLAS_PASSWORD_FILE=
