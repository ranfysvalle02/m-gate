# Keep the build context small and deterministic. The compiled wasm module
# cache is rebuilt inside the image (see Dockerfile); never ship stale host
# artifacts, and never copy the local virtualenv or VCS metadata.
.git
.gitignore
# Never bake local secrets (VOYAGE_API_KEY, etc.) into the image. Runtime config
# is supplied via compose `environment:` / Render dashboard env vars instead.
.env
.venv
venv
vendor/.wasm-cache/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
*.log
# Captured admin-console screenshots are docs, not runtime assets.
screenshots/
